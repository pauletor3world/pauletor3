# Configuração do servidor. Copie para config.env e ajuste.
# O deploy.ps1 envia este arquivo para /opt/minecraft/config.env na VM.
# Depois de mudar algo aqui, rode o deploy.ps1 de novo para aplicar.

# Onde a VM roda: gcp (Google Cloud, x86_64) ou oracle (Oracle Cloud, ARM).
# Muda só o firewall: gcp usa ufw; oracle usa iptables antes da regra REJECT da imagem.
PROVIDER="gcp"

# Versão do Minecraft. O servidor é Fabric + Lithium (só no servidor: os jogadores
# entram com o cliente vanilla, sem mods).
MC_VERSION="1.21.11"
# 1 = aceita loader do Fabric instável ou Lithium beta se não houver versão estável
ALLOW_EXPERIMENTAL=0
# Opcional: e-mail ou URL de contato no User-Agent das APIs (Modrinth pede)
UPDATE_CONTACT=""

# Memória da JVM. A VM tem 8 GB; 5G deixa folga para o sistema e o Tailscale.
MC_XMS="5G"
MC_XMX="5G"

# Texto na lista de servidores. Acentos funcionam (são convertidos para \uXXXX).
MOTD="Servidor dos amigos"

# Porta do jogo (não use 25575, que é o RCON)
MC_PORT=25565

# 1 = abre MC_PORT para a internet. 0 = só via Tailscale (recomendado).
# NÃO use 1 com o servidor em modo offline: qualquer um entraria com qualquer nick.
PUBLIC_PORT=0

# Nome da máquina na sua rede Tailscale
TS_HOSTNAME="minecraft"
# Opcional: auth key do Tailscale (tskey-auth-...) para logar sem abrir link. Vazio = usa link.
TS_AUTHKEY=""

# Quantos backups diários manter
BACKUP_KEEP=7
